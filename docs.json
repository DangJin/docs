{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LinkAI",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/images/logo.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "API 参考",
        "groups": [
          {
            "group": "概述",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "图像生成",
            "pages": [
              "api-reference/image-generation",
              "api-reference/query-image-generation",
              "api-reference/query-images"
            ]
          },
          {
            "group": "视频生成",
            "pages": [
              "api-reference/video-generation",
              "api-reference/query-video-generation",
              "api-reference/query-videos"
            ]
          },
          {
            "group": "回调接口",
            "pages": [
              "api-reference/trans-callback",
              "api-reference/ai-callback-minmax"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "openapi": "/api-reference/openapi.json",
  "api": {
    "baseUrl": ""
  },
  "logo": "/images/logo.svg",
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "latex": true
  },
  "icons": {
    "library": "fontawesome"
  }
}
